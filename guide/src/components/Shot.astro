---
// A screenshot from .github/assets/screenshots, in the reader's theme: <Shot name="new" alt="…" />.
// Framed as a window so it reads as a picture of the app, not part of the page.
import { Image } from "astro:assets";

const shots = import.meta.glob<{ default: ImageMetadata }>(
  "../../../.github/assets/screenshots/*.png",
  { eager: true },
);
const { name, alt, width } = Astro.props as { name: string; alt: string; width?: number };
const pick = (theme: string) => {
  const shot = shots[`../../../.github/assets/screenshots/${name}-${theme}.png`];
  if (!shot) throw new Error(`no screenshot ${name}-${theme}.png`);
  return shot.default;
};
---

<figure class="shot">
  <div class="bar" aria-hidden="true"><span></span><span></span><span></span></div>
  <Image class="dark:sl-hidden" src={pick("light")} alt={alt} width={width} />
  <Image class="light:sl-hidden" src={pick("dark")} alt={alt} width={width} />
</figure>

<style>
  .shot {
    margin-inline: 0;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    overflow: hidden;
    box-shadow:
      0 1px 2px oklch(0 0 0 / 0.08),
      0 8px 24px -8px oklch(0 0 0 / 0.25);
  }
  .bar {
    display: flex;
    gap: 0.375rem;
    padding: 0.5rem 0.75rem;
    background: var(--sl-color-gray-6);
    border-bottom: 1px solid var(--sl-color-gray-5);
  }
  .bar span {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: var(--sl-color-gray-4);
    opacity: 0.6;
  }
  /* No display here: Starlight's sl-hidden shows only the reader's theme. */
  .shot :global(img) {
    vertical-align: bottom;
    width: 100%;
    height: auto;
    margin: 0;
  }
</style>
