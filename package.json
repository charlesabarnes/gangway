{
  "name": "gangway",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "prettier": {
    "printWidth": 100
  },
  "workspaces": [
    "shared",
    "server",
    "render"
  ],
  "scripts": {
    "typecheck": "node_modules/typescript-native/bin/tsc --noEmit -p shared && node_modules/typescript-native/bin/tsc --noEmit -p server && node_modules/typescript-native/bin/tsc --noEmit -p scripts && node_modules/typescript-native/bin/tsc --noEmit -p render && node_modules/typescript-native/bin/tsc --noEmit -p waitlist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "comments": "bun scripts/comment-density.ts",
    "test": "bun test --parallel --timings=server/test/timings.json server/test/unit shared/test render/test waitlist/test",
    "test:timings": "bun scripts/test-timings.ts",
    "test:int": "GANGWAY_REQUIRE_DOCKER=1 bun test server/test/unit shared/test server/test/integration",
    "test:e2e": "GANGWAY_E2E=1 GANGWAY_REQUIRE_DOCKER=1 bun test server/test",
    "dev": "bun --watch server/src/main.ts",
    "tunnel": "./scripts/dev-tunnel.sh",
    "build:render": "bun --cwd render build.ts && bun scripts/precompress.ts render/dist",
    "precompress": "bun scripts/precompress.ts web/dist/browser render/dist",
    "build:site": "bun scripts/build-site.ts",
    "build:badges": "bun scripts/build-badges.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.3",
    "@types/dockerode": "^4.0.2",
    "@types/tar-stream": "^3.1.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "opentype.js": "^2.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.0",
    "typescript-native": "npm:typescript@^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "@peculiar/x509": "^2.2.0",
    "acme-client": "^5.4.0",
    "dockerode": "^5.0.1",
    "hono": "^4.13.13",
    "nodemailer": "^10.1.7",
    "reflect-metadata": "^0.2.2",
    "tar-stream": "^3.2.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
