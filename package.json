{
  "name": "gangway",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "workspaces": [
    "shared",
    "server"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p shared && tsc --noEmit -p server",
    "test": "bun test server/test/unit shared/test",
    "test:int": "GANGWAY_REQUIRE_DOCKER=1 bun test server/test/unit shared/test server/test/integration",
    "test:e2e": "GANGWAY_E2E=1 GANGWAY_REQUIRE_DOCKER=1 bun test server/test",
    "dev": "bun --watch server/src/main.ts",
    "tunnel": "./scripts/tower-tunnel.sh"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/dockerode": "^4.0.1",
    "@types/tar-stream": "^3.1.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@peculiar/x509": "^2.1.0",
    "acme-client": "^5.4.0",
    "dockerode": "^5.0.1",
    "hono": "^4.13.8",
    "reflect-metadata": "^0.2.2",
    "tar-stream": "^3.2.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
