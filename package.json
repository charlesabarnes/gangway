{
  "name": "gangway",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "workspaces": [
    "shared",
    "server"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p shared && tsc --noEmit -p server",
    "test": "bun test server/test/unit shared/test",
    "test:int": "GANGWAY_REQUIRE_DOCKER=1 bun test server/test/unit shared/test server/test/integration",
    "test:e2e": "GANGWAY_E2E=1 GANGWAY_REQUIRE_DOCKER=1 bun test server/test",
    "dev": "bun --watch server/src/main.ts",
    "tunnel": "./scripts/tower-tunnel.sh"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
