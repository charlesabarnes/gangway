{
  "name": "gangway",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "workspaces": [
    "shared",
    "server",
    "render"
  ],
  "scripts": {
    "typecheck": "node_modules/typescript-native/bin/tsc --noEmit -p shared && node_modules/typescript-native/bin/tsc --noEmit -p server && node_modules/typescript-native/bin/tsc --noEmit -p scripts && node_modules/typescript-native/bin/tsc --noEmit -p render",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "comments": "bun scripts/comment-density.ts",
    "test": "bun test --parallel --timings=server/test/timings.json server/test/unit shared/test render/test",
    "test:timings": "bun scripts/test-timings.ts",
    "test:int": "GANGWAY_REQUIRE_DOCKER=1 bun test server/test/unit shared/test server/test/integration",
    "test:e2e": "GANGWAY_E2E=1 GANGWAY_REQUIRE_DOCKER=1 bun test server/test",
    "dev": "bun --watch server/src/main.ts",
    "tunnel": "./scripts/dev-tunnel.sh",
    "build:render": "bun --cwd render build.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "@types/dockerode": "^4.0.1",
    "@types/tar-stream": "^3.1.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.1",
    "typescript-native": "npm:typescript@^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@peculiar/x509": "^2.1.0",
    "acme-client": "^5.4.0",
    "dockerode": "^5.0.1",
    "hono": "^4.13.8",
    "reflect-metadata": "^0.2.2",
    "tar-stream": "^3.2.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
